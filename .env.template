# Copy this file to `.env` and adjust as needed.
# The values below are consistent with the service names defined in
# docker-compose.yml (db, elasticsearch) - if you run the app outside
# docker-compose (e.g. directly with `uv run`), change POSTGRES_HOST and
# ELASTICSEARCH_URL to point at wherever those services actually run
# (e.g. localhost).

# --- Postgres ---
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=test_apr

# --- Elasticsearch ---
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_INDEX=documents

# --- App ---
APP_HOST=0.0.0.0
APP_PORT=8000

# --- Search ---
SEARCH_DEFAULT_LIMIT=20
SEARCH_MAX_LIMIT=100
SEARCH_MAX_CANDIDATES=10000
